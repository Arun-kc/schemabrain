*.prof
*.lprof
prof/

# Local override files (never committed)
docker-compose.override.yml
docker-compose.override.yaml
*.local.yml
*.local.yaml

# Logs
*.log
logs/

# Claude
.claude/

# Antigravity
.antigravity/
.antigravityignore

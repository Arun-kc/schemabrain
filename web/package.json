{
  "name": "schemabrain-dashboard",
  "version": "0.4.0",
  "private": true,
  "description": "SchemaBrain v0.4 read-only dashboard — PII Visualization, Refusal UI, Audit Viewer.",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "export": "next build && cp -R out ../schemabrain/dashboard/static/",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",

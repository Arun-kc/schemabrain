{
  "mcpServers": {
    "schemabrain": {
      "type": "stdio",
      "command": "/ABSOLUTE/PATH/TO/.venv/bin/schemabrain",
      "args": [
        "serve",
        "--url-env",
        "DATABASE_URL",
        "--store-path",
        "/ABSOLUTE/PATH/TO/schemabrain.db"
      ],
      "env": {
        "DATABASE_URL": "postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME"
      }
    }
  }
}

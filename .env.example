# Postgres connection string for the database to index.
# The wizard (`schemabrain init`) reads this as the default source URL.
# Example: postgresql+psycopg://user:password@localhost:5432/mydb
SCHEMABRAIN_DATABASE_URL=

# Anthropic API key for LLM-powered semantic enrichment.
# Get one at https://console.anthropic.com/
# Required for entity/metric LLM curation; optional otherwise.
ANTHROPIC_API_KEY=

# Hard cap on LLM spend per LLM-driven stage (entities, metrics, enrichment),
# in USD. The stage aborts if estimated cost exceeds this. Default 10.
SCHEMABRAIN_MAX_LLM_COST_USD=10

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL (case-insensitive).
# Default WARNING. Use the `-v` flag in a terminal; this env var is the
# fallback when the host (Claude Desktop, etc.) spawns the server.
SCHEMABRAIN_LOG_LEVEL=INFO
